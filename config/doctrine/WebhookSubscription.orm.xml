<?xml version="1.0" encoding="UTF-8" ?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
  <entity name="EMS\CoreBundle\Entity\WebhookSubscription" table="webhook_subscription">

    <id name="id" type="uuid" column="id">
      <generator strategy="CUSTOM"/>
      <custom-id-generator class="Ramsey\Uuid\Doctrine\UuidGenerator"/>
    </id>

    <field name="endpointUrl" length="255"/>
    <field name="secret" length="255"/>
    <field name="errorMessage" length="2048" nullable="true"/>
    <field name="events" type="json"/>
    <field name="enabled" type="boolean">
      <options>
        <option name="default">1</option>
      </options>
    </field>

    <field name="created" type="datetime"/>
    <field name="modified" type="datetime"/>
    <lifecycle-callbacks>
      <lifecycle-callback type="prePersist" method="updateModified" />
      <lifecycle-callback type="preUpdate" method="updateModified" />
    </lifecycle-callbacks>
  </entity>
</doctrine-mapping>
