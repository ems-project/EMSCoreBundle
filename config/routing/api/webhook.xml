<?xml version="1.0" encoding="UTF-8" ?>

<routes xmlns="http://symfony.com/schema/routing"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://symfony.com/schema/routing https://symfony.com/schema/routing/routing-1.0.xsd">

    <route id="emsco_api_webhook_subscribe" path="/webhook-subscriptions"
           controller="EMS\CoreBundle\Controller\Api\WebhookSubscriptionController::subscribe"
           methods="POST"
           format="json">
    </route>
    <route id="emsco_api_webhook_unsubscribe" path="/webhook-subscriptions/{id}"
           controller="EMS\CoreBundle\Controller\Api\WebhookSubscriptionController::unsubscribe"
           methods="DELETE"
           format="json">
    </route>

</routes>
