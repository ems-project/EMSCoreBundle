{% extends '@EMSCore/base.html.twig' %}{% trans_default_domain 'emsco-core' %}


{% block title %}{{ 'title.error'|trans }}{% endblock %}
{% block pagetitle %}{{ 'title.error_page'|trans }}{% endblock %}
{% block subtitle %}<small>{{ 'title.error_sub' }}</small>{% endblock %}

{% block breadcrumb %}
{% endblock %}


{% block body %}
<div class="row">
	<div class="col-md-6 col-md-offset-3 col-lg-4 col-lg-offset-4">
		<div class="box box box-solid">
			<div class="box-header with-border bg-danger">
				<h4 class="box-title">
						<i class="icon fa fa-danger fa-2x"></i>
						{{ 'message.error_status_code'|trans({ 'status_code': status_code }) }}
				</h4>
			</div>
			<div class="box-body ">
				<p>{{ 'message.error_status'|trans({ 'status': status_text }) }}</p>
			</div>
		</div>

	</div>
</div>
{% endblock %}

