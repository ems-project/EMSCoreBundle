{% trans_default_domain 'emsco-core' %}

{% set status = this.status %}

<aside class="main-sidebar">
    <section class="sidebar" data-testid="sidebar">
        <div class="user-panel">
            <div class="pull-left image">
                {% include '@EMSCore/elements/user-image.html.twig' with { 'class': 'img-circle' } %}
            </div>
            <div class="pull-left info">
                {% if app.user %}
                    <p><a href="{{ path(routes.USER_PROFILE) }}" class="">{{ app.user.displayName }}</a></p>
                {% else %}
                    <p>{{ 'key.anonymous_user'|trans }}</p>
                {% endif %}
                {%- if status is defined -%}
                    <a href="{{ path('elasticsearch.status') }}" id="status-overview" data-testid="status-overview">
                        <i class="fa fa-circle text-{{ status }}"></i> {{ status }}
                    </a>
                {%- endif -%}
            </div>
        </div>
        {% if app.user %}
            <form action="{{ path('ems_quick_search') }}" method="get" class="sidebar-form">
                <div class="input-group">
                    <label for="q" class="sr-only">{{ 'field.quick_search'|trans }}</label>
                    <input id="q" type="text" name="q" class="form-control" placeholder="{{ 'message.search_placeholder'|trans }}" data-testid="search-general-query">
                    <span class="input-group-btn">
                        <button type="submit" name="search" id="search-btn" class="btn btn-flat" data-testid="search-general-submit"><i class="fa fa-search"></i>
                        </button>
                    </span>
                </div>
            </form>
        {% endif %}

        {% for item in this.menus|filter(p => p.hasChildren) %}
            <ul class="sidebar-menu" data-widget="tree" data-testid="sidebar-menu-tree">
                <li class="header">{{ item.title|trans }}</li>
                {% for menu in item.children %}
                    {{ _self.item(this, menu) }}
                {% endfor %}
            </ul>
        {% endfor %}
    </section>
</aside>

{% macro item(component, menu, parentSlug = '') %}
    {% set menuLabel = menu.label is ems_translatable_message ? menu.label|trans : menu.label %}
    {% set menuColor = menu.color|default('') %}
    {% set slug = menuLabel|ems_slug %}
    {% set path = menu.route is not null ? path(menu.route, menu.routeParameters) : null %}
    {% set active = component.isPathActive(path) %}

    {%- if active == false -%}
        {%- set activeChildren = menu.children|filter(i => i.route is not null and component.isPathActive(path(i.route, i.routeParameters))) -%}
        {%- set active = activeChildren|length > 0 -%}
    {%- endif -%}

    <li class="{{ html_classes({'treeview': menu.hasChildren, 'active': active }) }}">
        <a href="{{ menu.hasChildren ? '#' : path|default('#') }}"
           class="{{ html_classes( { ("text-#{menuColor}"): menuColor != ''}) }}"
           data-testid="menu-item-{{ parentSlug }}{{ slug }}">
            <i class="{{ menu.icon }}"></i>&nbsp;<span>{{ menuLabel }}</span>
            {% if menu.hasBadge %}
                <span class="label {{ menu.badgeColor ? 'bg-' ~ menu.badgeColor : 'label-default' }} pull-right-container">{{ menu.badge }}</span>
            {% elseif menu.hasChildren %}
                <i class="fa fa-angle-left pull-right"></i>
            {% endif %}
        </a>
        {% if menu.hasChildren %}
            <ul class="treeview-menu">
                {% for child in menu.children %}
                    {{ _self.item(component, child, parentSlug ~ slug ~ '-') }}
                {% endfor %}
            </ul>
        {% endif %}
    </li>
{% endmacro %}