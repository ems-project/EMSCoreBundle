{% trans_default_domain 'emsco-component' %}

{% block bodyAddFolder %}
    {% include '@EMSCore/core/alerts.twig' %}
    {{ form(form) }}
{% endblock %}

{% block footerAddFolder %}
    <button id="ajax-modal-submit" class="btn btn-sm btn-primary" data-testid="media-lib-add-folder-submit">{{ 'media_library.folder.add.submit'|trans }}</button>
    <button type="button" class="btn btn-sm btn-default" data-dismiss="modal" data-testid="media-lib-add-folder-cancel">{{ 'media_library.folder.add.cancel'|trans }}</button>
{% endblock %}