{%- trans_default_domain 'emsco-core' -%}
{# @var template \EMS\CoreBundle\Core\Component\MediaLibrary\Template\MediaLibraryTemplate #}
{# @var config \EMS\CoreBundle\Core\Component\MediaLibrary\Config\MediaLibraryConfig #}
{# @var mediaFile \EMS\CoreBundle\Core\Component\MediaLibrary\File\MediaLibraryFile #}
{# @var mediaFolder \EMS\CoreBundle\Core\Component\MediaLibrary\Folder\MediaLibraryFolder #}

{%- block media_lib_header -%}
    <div class="media-lib-container">
        <div class="ems-btn-group">
            {{- template.block('media_lib_button_home', _context)|raw -}}
            {{- template.block('media_lib_button_folder_add', _context)|raw -}}
            {{- template.block('media_lib_button_upload', _context)|raw -}}
        </div>
        {%- if mediaFile is defined -%}
            <div class="ems-btn-group">
                {{- template.block('media_lib_button_file_view', _context)|raw -}}
                {{- template.block('media_lib_button_file_revision', _context)|raw -}}
                {{- template.block('media_lib_button_file_rename', _context)|raw -}}
                {{- template.block('media_lib_button_files_move', _context)|raw -}}
                {{- template.block('media_lib_button_file_delete', _context)|raw -}}
            </div>
        {%- elseif selectionFiles > 0 -%}
            <div class="ems-btn-group">
                {{- template.block('media_lib_button_files_move', _context)|raw -}}
                {{- template.block('media_lib_button_files_delete', _context)|raw -}}
            </div>
        {%- elseif mediaFolder is defined -%}
            <div class="ems-btn-group">
                {{- template.block('media_lib_button_folder_delete', _context)|raw -}}
                {{- template.block('media_lib_button_folder_move', _context)|raw -}}
                {{- template.block('media_lib_button_folder_rename', _context)|raw -}}
            </div>
        {%- endif -%}
    </div>
    <div class="media-lib-container">
        {{- template.block('media_lib_search_box', _context)|raw -}}
    </div>
{%- endblock media_lib_header -%}

{%- block media_lib_file_header_row -%}
    <li>
        <div class="media-lib-container">
            <div class="media-lib-file-header">
                {{- template.block('media_lib_file_header', _context)|raw -}}
            </div>
        </div>
    </li>
{%- endblock media_lib_file_header_row -%}

{%- block media_lib_file_header -%}
    <div data-sort-id="name">Name</div>
    <div data-sort-id="type">Type</div>
    <div data-sort-id="size" class="text-right">Size</div>
{%- endblock media_lib_file_header -%}

{%- block media_lib_file_rows -%}
    {%- for mediaFile in mediaFiles|default([]) -%}
        {{- template.block('media_lib_file_row', _context)|raw -}}
    {%- endfor -%}
{%- endblock media_lib_file_rows -%}

{%- block media_lib_file_row -%}
    <li>
        <div class="media-lib-container">
            <div class="media-lib-file" data-id="{{- mediaFile.id -}}" data-ems-id="{{- mediaFile.emsId -}}" data-json="{{ mediaFile.getDataJson()|e('html_attr') }}" data-testid="media-lib-file-item">
                {{- template.block('media_lib_file', _context)|raw -}}
            </div>
        </div>
    </li>
{%- endblock media_lib_file_row -%}

{% block media_lib_file %}
    <div>
        <a class="btn-file-view" href="{{- mediaFile.urlView -}}" data-id="{{- mediaFile.id -}}">
            {{ mediaFile.folder[folder.path|default('')|length + 1:] }}{{- mediaFile.name -}}
        </a>
    </div>
    <div>{{- mediaFile.file.mimetype|trans({}, 'ems-mimetypes') -}}</div>
    <div class="text-right">{{- mediaFile.file.filesize|ems_format_bytes -}}</div>
{% endblock media_lib_file %}

{% block media_lib_folder_rows %}
    {% for item in structure %}
        {% set folder = item.folder %}
        {% set children = item.children|default([]) %}
        {{- template.block('media_lib_folder_row', _context)|raw -}}
    {% endfor %}
{% endblock media_lib_folder_rows %}

{% block media_lib_folder_row %}
    <li class="{{ html_classes({ 'has-children': children|length > 0 }) }}">
        <div class="media-lib-container">
            <div class="media-lib-folder" data-id="{{ folder.id }}" data-path="{{ folder.path }}" data-testid="media-lib-folder-item" >
                {{- template.block('media_lib_folder', _context)|raw -}}
            </div>
        </div>
        {% if children|length > 0 %}
            <ul>
                {% with { 'structure': children } %}{{ template.block('media_lib_folder_rows', _context)|raw }}{% endwith %}
            </ul>
        {% endif %}
    </li>
{% endblock media_lib_folder_row %}

{% block media_lib_folder %}
    <div>{{ folder.name }}</div>
{% endblock media_lib_folder %}

{%- block media_lib_footer -%}
    <div class="media-lib-container">
        {% if mediaInfo is defined %}
            {% if mediaInfo.searchTotal is defined and mediaInfo.searchSize is defined %}
                {% set info = "Search result #{mediaInfo.loaded} of #{mediaInfo.searchTotal} (#{mediaInfo.searchSize|ems_format_bytes})" %}
            {% else %}
                {% set info = "Files #{mediaInfo.loaded} of #{mediaInfo.folderTotal} (#{mediaInfo.folderSize|ems_format_bytes})" %}
            {% endif %}
            {% if selectionFiles > 1 %}
                {% set info = info ~ " | #{selectionFiles} files selected" %}
            {% elseif selectionFiles == 1 %}
                {% set info = info ~ " | #{selectionFiles} file selected" %}
            {% endif %}
            {{ info }}
        {% endif %}
    </div>
{%- endblock media_lib_footer -%}

{%- block media_lib_button_home -%}
    <button class="ems-btn btn-home" data-ems-icon="home" data-testid="media-lib-button-home">
        {{- buttonLabel|default('media_library.home'|trans) -}}
    </button>
{%- endblock media_lib_button_home -%}

{%- block media_lib_button_folder_add -%}
    <button class="ems-btn btn-folder-add" data-ems-icon="folder" data-testid="media-lib-button-folder-add">
        {{- buttonLabel|default('media_library.folder.add.title'|trans) -}}
    </button>
{%- endblock media_lib_button_folder_add -%}

{%- block media_lib_button_folder_delete -%}
    <button class="ems-btn btn-folder-delete" data-ems-icon="folder-delete" data-id="{{- mediaFolder.id -}}" data-modal-size="md" data-testid="media-lib-button-folder-delete">
        {{- buttonLabel|default('media_library.folder.delete.title'|trans) -}}
    </button>
{%- endblock media_lib_button_folder_delete -%}

{%- block media_lib_button_folder_rename -%}
    <button class="ems-btn btn-folder-rename" data-ems-icon="folder-rename" data-id="{{- mediaFolder.id -}}" data-testid="media-lib-button-folder-rename">
        {{- buttonLabel|default('media_library.folder.rename.title'|trans) -}}
    </button>
{%- endblock media_lib_button_folder_rename -%}

{%- block media_lib_button_folder_move -%}
    <button class="ems-btn btn-folder-move" data-ems-icon="folder-move" data-id="{{- mediaFolder.id -}}" data-modal-size="md" data-testid="media-lib-button-folder-move">
        {{- buttonLabel|default('media_library.folder.move.title'|trans) -}}
    </button>
{%- endblock media_lib_button_folder_move -%}

{%- block media_lib_button_file_rename -%}
    <button class="ems-btn btn-file-rename" data-ems-icon="file-rename" data-id="{{- mediaFile.id -}}" data-testid="media-lib-button-file-rename">
        {{- buttonLabel|default('media_library.file.rename.title'|trans) -}}
    </button>
{%- endblock media_lib_button_file_rename -%}

{%- block media_lib_button_file_delete -%}
    <button class="ems-btn btn-file-delete" data-ems-icon="file-delete" data-id="{{- mediaFile.id -}}" data-testid="media-lib-button-file-delete">
        {{- buttonLabel|default('media_library.file.delete.title'|trans) -}}
    </button>
{%- endblock media_lib_button_file_delete -%}

{%- block media_lib_button_file_view -%}
    <button class="ems-btn btn-file-view" data-ems-icon="file-view" data-id="{{- mediaFile.id -}}" data-testid="media-lib-button-file-view">
        {{- buttonLabel|default('media_library.file.view.title'|trans) -}}
    </button>
{%- endblock media_lib_button_file_view -%}

{%- block media_lib_button_file_revision -%}
    <a class="ems-btn" href="{{ path('emsco_view_revisions', { 'type': mediaFile.document.contentType, 'ouuid': mediaFile.id  }) }}" data-ems-icon="revision" data-testid="media-lib-button-file-revision">
        {{- buttonLabel|default('media_library.file.revision.title'|trans) -}}
    </a>
{%- endblock media_lib_button_file_revision -%}

{%- block media_lib_button_files_delete -%}
    <button class="ems-btn btn-files-delete" data-ems-icon="file-delete" data-modal-size="md" data-testid="media-lib-button-files-delete">
        {{- buttonLabel|default('media_library.files.delete.title'|trans({ count: selectionFiles })) -}}
    </button>
{%- endblock media_lib_button_files_delete -%}

{%- block media_lib_button_files_move -%}
    <button class="ems-btn btn-files-move" data-ems-icon="file-move" data-modal-size="md" data-testid="media-lib-button-files-move">
        {{- buttonLabel|default('media_library.files.move.title'|trans({ count: selectionFiles })) -}}
    </button>
{%- endblock media_lib_button_files_move -%}

{%- block media_lib_button_upload -%}
    <label class="ems-btn btn-file-upload" data-ems-icon="upload" for="media-lib-upload-{{- id -}}">
        {{- buttonLabel|default('media_library.file.add.title'|trans) -}}
    </label>
{%- endblock media_lib_button_upload -%}

{%- block media_lib_breadcrumb -%}
    <ul class="media-lib-list-breadcrumb" data-testid="media-lib-breadcrumb">
        <li><button class="media-lib-breadcrumb-item" data-ems-icon="home">Home</button></li>
        {%- if mediaFolder is defined -%}
            {%- for parent in mediaFolder.parents -%}
                <li><button class="media-lib-breadcrumb-item" data-id="{{- parent.id -}}">{{- parent.name -}}</button></li>
            {%- endfor -%}
            {%- if mediaFile is defined -%}
                <li><button>{{- mediaFile.file.filename -}}</button></li>
            {%- endif -%}
        {%- endif -%}
    </ul>
{%- endblock media_lib_breadcrumb -%}

{% block media_lib_search_box %}
    <label for="media-lib-search-{{- id -}}" class="sr-only">Media library search</label>
    <input id="media-lib-search-{{- id -}}"
           class="{{ html_classes('media-lib-search', {
               'active': searchValue|default('')|length > 0
           }) }}"
           type="text"
           value="{{ searchValue|default('') }}"
           placeholder="Search ..."
           data-testid="media-lib-search-input">
{% endblock media_lib_search_box %}

{%- block media_lib_modal_title -%}
    {{- title -}}
{%- endblock media_lib_modal_title -%}

{%- block media_lib_modal_body -%}
    {% if confirmMessage is defined %}
        <div class="alert alert-warning" role="alert">{{ confirmMessage|nl2br }}</div>
    {% endif %}
    {% if infoMessage is defined %}
        <div class="alert alert-info" role="alert">{{ infoMessage|nl2br }}</div>
    {% endif %}
    {%- if form is defined -%}
        {{- form(form) -}}
    {%- endif -%}
{%- endblock media_lib_modal_body -%}

{%- block media_lib_modal_footer -%}
    {%- set type = type|default(false) -%}
    {%- if type == 'delete_files' -%}
        <button id="ajax-modal-submit" class="ems-btn" data-ems-icon="delete" data-variant="danger" data-testid="media-lib-modal-submit">
            {{- 'media_library.files.delete.submit'|trans -}}
        </button>
    {%- elseif type == 'delete_folder' -%}
        <button id="ajax-modal-submit" class="ems-btn" data-ems-icon="delete" data-variant="danger" data-testid="media-lib-modal-submit">
            {{- 'media_library.folder.delete.submit'|trans -}}
        </button>
    {%- elseif type == 'move_files' -%}
        <button id="ajax-modal-submit" class="ems-btn" data-ems-icon="file-move" data-variant="primary" data-testid="media-lib-modal-submit">
            {{- 'media_library.files.move.submit'|trans -}}
        </button>
    {%- elseif type == 'move_folder' -%}
        <button id="ajax-modal-submit" class="ems-btn" data-ems-icon="folder-move" data-variant="primary" data-testid="media-lib-modal-submit">
            {{- 'media_library.folder.move.submit'|trans -}}
        </button>
    {%- elseif type == 'rename_file' -%}
        <button id="ajax-modal-submit" class="ems-btn" data-ems-icon="file-rename" data-variant="primary" data-testid="media-lib-modal-submit">
            {{- 'media_library.folder.rename.submit'|trans -}}
        </button>
    {%- elseif type == 'rename_folder' -%}
        <button id="ajax-modal-submit" class="ems-btn" data-ems-icon="folder-rename" data-variant="primary" data-testid="media-lib-modal-submit">
            {{- 'media_library.folder.rename.submit'|trans -}}
        </button>
    {%- else -%}
        {% if form is defined %}
            <button id="ajax-modal-submit" class="ems-btn" data-variant="primary" data-testid="media-lib-modal-submit">
                <i class="{{ html_classes('fa', submitIcon|default('fa-save')) }}"></i>
                {{ submitLabel|default('media_library.submit'|trans) }}
            </button>
        {% endif %}
    {%- endif -%}
    <button type="button" class="ems-btn" data-dismiss="modal" data-testid="media-lib-modal-cancel">{{ 'media_library.close'|trans }}</button>
{%- endblock media_lib_modal_footer -%}

{% block media_lib_modal_preview %}
    {% set url = ems_asset_path(mediaFile.file) %}
    <div class="media-lib-preview-modal" data-type="{{ mediaFile.fileMimetype }}">
        <div class="media-lib-preview-file">
            {% if mediaFile.fileMimetype starts with 'image/' %}
                <img src="{{ ems_asset_path(mediaFile.file, {
                    _config_type: 'image'
                }) }}" alt="{{ mediaFile.giveName }}"/>
            {% else %}
                <object data="{{ url }}" type="{{ mediaFile.fileMimetype }}">
                    <div class="alert alert-info" role="alert">
                        {{ fallback|default('media_library.file.view.fallback'|trans) }}
                        <a href="{{ url }}">{{ fallback|default('media_library.file.view.download'|trans) }}</a>
                    </div>
                </object>
            {% endif %}
        </div>
        <div class="media-lib-preview-info">
            {{- template.block('media_lib_modal_preview_info', _context)|raw -}}
        </div>
    </div>
{% endblock media_lib_modal_preview %}

{% block media_lib_modal_preview_info %}
    <ul>
        <li>Size: {{ mediaFile.filesize|ems_format_bytes }}</li>
        <li>Type: {{ mediaFile.fileMimetype|trans({}, 'ems-mimetypes') }}</li>
    </ul>
{% endblock media_lib_modal_preview_info %}

{% block media_lib_modal_preview_footer %}
    <button class="ems-btn btn-preview-prev" data-ems-icon="chevrons-left" style="display: none;">
        {{ 'media_library.file.view.previous'|trans }}
    </button>
    <button class="ems-btn btn-preview-next" data-ems-icon="chevrons-right" data-ems-icon-position="end" style="display: none;">
        {{ 'media_library.file.view.next'|trans }}
    </button>
{% endblock media_lib_modal_preview_footer %}