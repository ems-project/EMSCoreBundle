{% extends '@EMSCore/base.html.twig' %}
{% trans_default_domain 'emsco-core' %}

{% block title %}
    {% if revision.ouuid %}
        {{ 'views.data.edit-revision-html.title'|trans({'{contentType}': revision.contentType.singularName, '{revision}': revision|emsco_display }) }}
    {% else %}
        {{ 'views.data.edit-revision-html.new-draft-title'|trans({'{contentType}': revision.contentType.singularName }) }}
    {% endif %}
{% endblock %}

{% block pagetitle %}{{ block('title') }}{% endblock %}