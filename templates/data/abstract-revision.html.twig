{% extends '@EMSCore/base.html.twig' %}
{% trans_default_domain 'emsco-core' %}

{% block title %}
    {% if revision.ouuid %}
        {{ 'title.edit_revision_content_type'|trans({'{contentType}': revision.contentType.singularName, '{revision}': revision|emsco_display }) }}
    {% else %}
        {{ 'title.new_draft'|trans({'{contentType}': revision.contentType.singularName }) }}
    {% endif %}
{% endblock %}

{% block pagetitle %}{{ block('title') }}{% endblock %}