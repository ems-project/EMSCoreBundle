{% extends '@EMSCore/base.html.twig' %}{% trans_default_domain 'emsco-core' %}

{% block title %}Add a new {{ contentType.singularName }}{% endblock %}
{% block pagetitle %}Add a new {{ contentType.singularName }}{% endblock %}
{% block subtitle %}<small>{{ 'title.content_type_create_ouuid'|trans({ 'content_type': contentType.singularName }) }}</small>{% endblock %}


{% block body %}

<div class="row">
	<div class="col-md-6">
		<div class="box ">
			<div class="box-header with-border">
				<i class="fa fa-warning"></i>
				<h3 class="box-title">Notice</h3>
			</div>
			<!-- /.box-header -->
			<div class="box-body">
				<p>{{ 'message.content_type_info_ouuid'|trans({ 'content_type': contentType.singularName  })|raw|nl2br }}</p>
			</div>
			<!-- /.box-body -->
		</div>
	</div>
	<div class="col-md-6">
		<!-- general form elements -->
		<div class="box box-primary">
			<div class="box-header with-border">
				<h3 class="box-title">New {{ contentType.name }}</h3>
			</div>
			<!-- /.box-header -->
			<!-- form start -->
			{{ form_start(form) }}
				
				<div class="box-body">
					{{ form_row(form.ouuid) }}

				</div>
				<!-- /.box-body -->
				<div class="box-footer">
					{{ form_widget(form.save) }}
				</div>
			{{ form_end(form) }}

		</div>
		<!-- /.box -->
	</div>
</div>
{% include '@EMSCore/app/menu.html.twig' with {
	'item':  'data-add-' ~ contentType.id
}%}
{% endblock %}	