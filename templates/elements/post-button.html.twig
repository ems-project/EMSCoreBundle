{% trans_default_domain 'emsco-core' %}
{%- set settings = {
	'form': (destinationFormName|default(false)),
	'action': (action is defined ? action|json_encode : false),
	'name': (name is defined  ? name|json_encode : false),
	'value': (value is defined  ? value|json_encode : false),
}|filter(v => v != false) -%}
{% set testId = attributes|default([])|filter((a,k) => 'data-testid' is same as(k)) %}
{% set attrWithoutTesId = attributes|default([])|filter((a,k) => 'data-testid' is not same as(k))|map((v,k) => "#{k}=#{v}")|join(' ')  %}
{% set attributes = attributes|default([])|map((v,k) => "#{k}=#{v}")|join(' ') %}

{% if message is defined and message != null %}
	<div class="btn-group{% if group_class is defined %} {{ group_class }}{% endif %}">
	  <button type="button" class="{% if btnClass is defined %}{{ btnClass }}{% else %}btn btn-sm btn-{{ btnType|default('primary') }}{% endif %} dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" {{ attributes }}>
			{% if icon is defined %}
				<span class="{{ icon starts with 'glyphicon-' ? "glyphicon #{icon}" : "fa fa-#{icon}" }}"></span>&nbsp;
			{% endif %}
			{% if label is defined %}
				{{ label is ems_translatable_message ? label|trans : label }}
			{% elseif rawlabel is defined %}
				{{ rawlabel|raw }}
			{% endif %}
		<span class="caret"></span>
	  </button>
	  <ul class="dropdown-menu">
		<li>
			{% if url is defined %}
				<a href="{{ url }}"
				   data-post-settings="{{ settings|json_encode|escape('html_attr') }}"
				   class="core-post-button"{% if testId|length > 0 %} data-testid="{{ testId|first  ~ '-message' }}"{% endif %} {{ attrWithoutTesId }}>{{ message is ems_translatable_message ? message|trans : message }}</a>
			{% else %}
				<button{% if testId|length > 0 %} data-testid="{{ testId|first  ~ '-message' }}"{% endif %} {{ attrWithoutTesId }}>{{ message is ems_translatable_message ? message|trans : message }}</button>
			{% endif %}
		</li>
	  </ul>
	</div>
{% else %}
	{% if url is defined %}
		<a class="core-post-button {% if btnClass is defined %}{{ btnClass }}{% else %}btn btn-sm btn-{{ btnType|default('primary') }}{% endif %}"
			data-post-settings="{{ settings|json_encode|escape('html_attr') }}"
			href="{{ url }}" {{ attributes }}>
			{% if icon is defined %}
				<span class="{{ icon starts with 'glyphicon-' ? "glyphicon #{icon}" : "fa fa-#{icon}" }}"></span>&nbsp;
			{% endif %}
			{% if label is defined %}{{ label is ems_translatable_message ? label|trans : label }}{% endif %}
		</a>
	{% else %}
		<button class="{% if btnClass is defined %}{{ btnClass }}{% else %}btn btn-sm btn-{{ btnType|default('primary') }}{% endif %}" {{ attributes|default('') }}>
			{% if icon is defined %}
				<span class="{{ icon starts with 'glyphicon-' ? "glyphicon #{icon}" : "fa fa-#{icon}" }}"></span>&nbsp;
			{% endif %}
			{% if label is defined %}{{ label is ems_translatable_message ? label|trans : label }}{% endif %}
		</button>
	{% endif %}
{% endif %}