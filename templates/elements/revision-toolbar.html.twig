{% trans_default_domain 'emsco-core' -%}
<div class="btn-group{% if vertical is defined and vertical %}-vertical{% endif %}">
	{% if withView is not defined or withView %}
        {% include '@EMSCore/elements/get-button.html.twig' with {
			'url': path('emsco_view_revisions', {
				'type': instance.contentType.name,
				'ouuid': instance.ouuid,
				'revisionId': revisionId,
			}),
			'btnType': 'primary',
			'label': 'action.view_this_revision'|trans,
			'icon': 'eye',
            'attributes': {
                'data-testid': 'revision-action-html-view'
            } }%}

	{% endif %}
	{% if current and not draft and is_granted(instance.contentType.roles.edit) %}
		{% include '@EMSCore/elements/post-button.html.twig' with {
			'url': path('emsco_data_new_draft', {'ouuid': revision.ouuid, 'type':revision.contentType.name, 'item': app.request.query.get('item') }),
			'label': 'action.edit'|trans,
			'btnType': 'primary',
			'icon': 'pencil',
            'attributes': {
                'data-testid': 'revision-action-new-draft'
            } }%}
	{% endif %}
	{% if draft %}
		{% if is_granted(instance.contentType.roles.edit) %}
			{% if not  instance.contentType.circlesField or attribute(instance.rawData, instance.contentType.circlesField) is not defined or attribute(instance.rawData, instance.contentType.circlesField)|emsco_in_my_circles %}
				<div class="btn-group">
					{% include '@EMSCore/elements/get-button.html.twig' with {
						'url': path('emsco_edit_revision', {'revisionId': revisionId, 'item': app.request.query.get('item') }),
						'label': 'action.edit_draft'|trans,
						'btnType': 'primary',
						'icon': 'pencil',
                        'attributes': {
                            'data-testid': 'revision-action-edit-draft'} }%}
					{% if is_granted('ROLE_SUPER') %}
						<div class="btn-group">
							<button type="button" class="btn btn-default btn-sm dropdown-toggle" data-toggle="dropdown">
								<span class="fa fa-ellipsis-h"></span>
							</button>
							<ul class="dropdown-menu">
								<li>
									<a href="{{ path('emsco_edit_json_revision', {'revision': revisionId}) }}">{{ 'key.edit_revision_json'|trans }}</a>
								</li>
							</ul>
						</div>
					{% endif %}
				</div>
				{% if autoSave  %}
                    {% include '@EMSCore/elements/post-button.html.twig' with {
						'url': path('emsco_data_cancel_modifications', {'revision': revisionId}),
						'message': 'message.cancel_last_modifications_confirm'|trans,
						'label': 'action.cancel'|trans,
						'btnType': 'default',
						'icon': 'remove',
                        'attributes': {
                            'data-testid': 'revision-action-cancel'
                        }
					}%}
				{% endif %}
				</div>
				<div class="btn-group">
                    {% if not autoSave  %}
						{% include '@EMSCore/elements/post-button.html.twig' with {
							'url': path('emsco_data_finalize', {'revision': revisionId}),
							'message': 'message.confirm_save_and_publish'|trans,
							'label': 'action.save_publish_in'|trans({'environment': instance.contentType.environment.label|default('')}),
							'btnType': 'default',
							'icon': 'check',
                            'attributes': {
                                'data-testid': 'revision-action-finalize-draft'
                            }
						}%}
                    {% endif %}
                    {% include '@EMSCore/elements/post-button.html.twig' with {
                        'url': path('emsco_discard_draft', {'revisionId': revisionId}),
                        'label': 'message.delete_this_draft'|trans,
                        'message': 'message.discard_draft_modification_lost'|trans,
                        'btnType': 'outline-danger',
                        'icon': 'trash',
                        'attributes': {
                            'data-testid': 'revision-action-discard-draft'
                        }
				}%}
			{% endif %}
		{% endif %}
	{% else %}
		{% for env in environmentsRevision.environments %}
            {% include '@EMSCore/elements/object-views-button.html.twig' with {
				'object':  object,
				'contentType': instance.contentType,
				'environment': env,
				'ouuid': revision.ouuid
			}%}
   		{% endfor %}


	   	{% if is_granted(instance.contentType.roles.edit) %}
	   		{% if not  instance.contentType.circlesField or attribute(object._source,instance.contentType.circlesField) is not defined or attribute(object._source,instance.contentType.circlesField)|emsco_in_my_circles %}


				<div class="btn-group">
					<button type="button" class="btn btn-default btn-sm dropdown-toggle" data-toggle="dropdown"  data-testid="revision-other-actions">
						<span class="sr-only">{{ 'key.other_revision_actions'|trans }}</span>
						<span class="fa fa-ellipsis-h"></span>
					</button>
					<ul class="dropdown-menu">
						{% if draft %}
							<li>{% include '@EMSCore/elements/get-button.html.twig' with {
                                    'url': path('emsco_edit_revision', {'revisionId': revisionId}),
                                    'btnClass': '',
                                    'label': 'action.edit_draft'|trans,
                                    'icon': 'pencil',
                                    'attributes': {
                                        'data-testid': 'revision-edit-draft'
                                    } }%}</li>
							{% if autoSave  %}
								<li>{% include '@EMSCore/elements/post-button.html.twig' with {
                                        'url': path('emsco_data_cancel_modifications', {'revision': revisionId}),
                                        'btnClass': '',
                                        'label': 'message.cancel_non_saved_modifications'|trans,
                                        'icon': 'remove',
                                        'attributes': {
                                            'data-testid': 'revision-action-cancel'
                                        }
								}%}</li>
							{% endif %}
						{% else %}
							{% if is_granted('ROLE_PUBLISHER') and revision.id|default(false) %}
								<li>{% include '@EMSCore/elements/get-button.html.twig' with {
										'url': path('emsco_pick_a_release', {revision: revision.id}),
										'btnClass': '',
										'label': 'action.add_to_release'|trans(),
										'icon': 'glyphicon glyphicon-pushpin',
                                        'attributes': {
                                            'data-testid': 'revision-action-pick-release'
                                        } }%}</li>
							{% endif %}
							{% if is_granted('ROLE_SUPER') and instance.contentType.environment not in environmentsRevision.environments %}
								<li>{% include '@EMSCore/elements/get-button.html.twig' with {
                                        'url': path('emsco_edit_revision', {'revisionId': revisionId}),
                                        'btnClass': ' ',
                                        'label': 'action.edit_revision'|trans,
                                        'icon': 'pencil',
                                        'attributes': {
                                            'data-testid': 'revision-action-edit'
                                        } }%}</li>
							{% endif %}
							{% if autoSave  %}
								<li>{% include '@EMSCore/elements/post-button.html.twig' with {
                                        'url': path('emsco_data_cancel_modifications', {'revision': revisionId}),
                                        'btnClass': '',
                                        'message': 'message.cancel_non_saved_modifications'|trans,
                                        'label': 'message.cancel_non_saved_modifications'|trans,
                                        'icon': 'remove',
                                        'attributes': {
                                            'data-testid': 'revision-action-cancel'
                                        } }%}</li>
							{% endif %}
								<li>{% include '@EMSCore/elements/post-button.html.twig' with {
                                        'url': path('emsco_data_revert', {'id': revisionId}),
                                        'btnClass': '',
                                        'label': 'action.revert_to_revision'|trans,
                                        'icon': 'undo',
                                        'attributes': {
                                            'data-testid': 'revision-action-revert-revision'} }%}</li>
						{% endif %}
						{% if rev is defined and revision is defined and compareId is defined and rev.id != revision.id and compareId != rev.id and compareId != revision.id %}
							<li>{% include '@EMSCore/elements/get-button.html.twig' with {
                                    'url': path('emsco_view_revisions', {
                                        'type': revision.contentType.name,
                                        'ouuid': revision.ouuid,
                                        'revisionId': rev.id > revision.id ? rev.id :revision.id,
                                        'compareId': rev.id < revision.id ? rev.id :revision.id,
                                        'page': page
                                    }),
                                    'btnClass': '',
                                    'label': 'action.compare_with_current'|trans,
                                    'icon': 'compress',
                                    'attributes': {
                                        'data-testid': 'revision-action-compare'
                                    } }%}</li>
						{% endif %}
					</ul>
				</div>
			{% endif %}
		{% endif %}

			</div>
			<div class="btn-group{% if vertical is defined and vertical %}-vertical{% endif %}">
				{% if environmentsRevision.publish|length > 0 %}
					<div class="btn-group">
					  <button type="button" class="btn btn-sm btn-default dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" data-testid="revision-action-publish-to">
							<span class="fa fa-toggle-on"></span>&nbsp;
							{{ 'field.publish_to'|trans }}
							<span class="caret"></span>
						</button>
						<ul class="dropdown-menu">
							{% for env in environmentsRevision.publish %}
								<li><a href="{{ path('revision.publish_to', {'revisionId': revisionId, 'envId': env.id}) }}" data-testid="revision-action-publish-to-{{ env.label|lower }}">{{ env.label }}</a></li>
							{% endfor %}
					   </ul>
					  </div>
			  {% endif %}

			  {% if environmentsRevision.unpublish|length > 0 %}
				<div class="btn-group">
					  <button type="button" class="btn btn-sm btn-outline-danger dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" data-testid="revision-action-unpublish-from">
							<span class="fa fa-toggle-off"></span>&nbsp;
							{{ 'field.unpublish_from'|trans }}
							<span class="caret"></span>
					  </button>
					   <ul class="dropdown-menu">
							{% for env in environmentsRevision.unpublish %}
								<li><a href="{{ path('revision.unpublish', {'revisionId': revisionId, 'envId': env.id}) }}" data-testid="revision-action-unpublish-from-{{ env.label|lower }}">{{ env.label }}</a></li>
							{% endfor %}
					   </ul>
				</div>
			  {% endif %}

			{% if emsco_is_super() and environmentsRevision.environments|length > 0 %}
				<div class="btn-group">
					<button type="button" class="btn btn-default btn-sm dropdown-toggle" data-toggle="dropdown">
						<span class="sr-only">{{ 'key.other_environment_actions'|trans }}</span>
						<span class="fa fa-ellipsis-h"></span>
					</button>
					<ul class="dropdown-menu">
						<li>{% include '@EMSCore/elements/post-button.html.twig' with {
							'url': path('emsco_data_reindex', {'revisionId': revisionId}),
							'btnClass': '',
							'label': 'action.re_index'|trans,
							'icon': 'recycle',
                            'attributes':{
                                'data-testid': 'revision-action-reindex'} }%}</li>
					</ul>
				</div>
			{% endif %}
	{% endif %}
</div>