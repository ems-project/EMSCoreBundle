{% trans_default_domain 'emsco-core' %}
<aside class="main-sidebar">
    <section class="sidebar" data-testid="sidebar">
        <div class="user-panel">
            <div class="pull-left image">
                {% include '@EMSCore/elements/user-image.html.twig' with { 'class': 'img-circle' } %}
            </div>
            <div class="pull-left info">
                {% if app.user %}
                    <p><a href="{{ path(routes.USER_PROFILE) }}" class="">{{ app.user.displayName }}</a></p>
                {% else %}
                    <p>{{ 'views.elements.side-menu-html.anonymous-user'|trans }}</p>
                {% endif %}
                {%- if status is defined -%}
                    <a href="{{ path('elasticsearch.status') }}" id="status-overview" data-testid="status-overview">
                        {%- with {
                            title: 'cluster.status'|trans({color: status}, 'emsco-core'),
                            status: status,
                        } -%}
                            {{ block('status', '@EMSCore/elasticsearch/status.html.twig') }}
                        {%- endwith -%}
                    </a>
                {%- endif -%}
            </div>
        </div>
        {% if app.user %}
            <form action="{{ path('ems_quick_search') }}" method="get" class="sidebar-form">
                <div class="input-group">
                    <label for="q" class="sr-only">{{ 'views.elements.side-menu-html.quick-search-label'|trans }}</label>
                    <input id="q" type="text" name="q" class="form-control" placeholder="{{ 'views.elements.side-menu-html.quick-search-placeholder'|trans }}" data-testid="search-general-query">
                    <span class="input-group-btn">
                        <button type="submit" name="search" id="search-btn" class="btn btn-flat" data-testid="search-general-submit"><i class="fa fa-search"></i>
                        </button>
                    </span>
                </div>
            </form>
        {% endif %}

        {% for item in menu|default([]) %}
            {% if item.hasChildren %}
                <ul class="sidebar-menu" data-widget="tree" data-testid="sidebar-menu-tree">
                    <li class="header">{{ item.title|trans(item.transParameters) }}</li>
                    {% for menu in item.children %}
                        {{ block('sidebarMenu', '@EMSCore/elements/menu.html.twig') }}
                    {% endfor %}
                </ul>
            {% endif %}
        {% endfor %}
    </section>
</aside>