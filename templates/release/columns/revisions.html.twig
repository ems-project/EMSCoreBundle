{% trans_default_domain 'emsco-core' %}

{% block publish_label %}{{ data.emsLink|emsco_display }}{% endblock %}
{% block unpublish_label %}{{ data.label }}{% endblock %}

{% block minrevid %}
    {% set release = table.context %}
    {% set minrev = data.minrevid|split('/') %}
    {% set maxrev = data.maxrevid|split('/') %}

    {% if minrev[0] == release.environmentSource.id %}
        {{ 'message.finalized_when_user'|trans({ 'date' : minrev[2]|date(date_time_format) ,'user' : minrev[3] }) }}
    {% elseif maxrev[0] == release.environmentSource.id %}
        {{ 'message.finalized_when_user'|trans({ 'date' : maxrev[2]|date(date_time_format) ,'user' : maxrev[3] }) }}
    {% else %}
        {{ 'message.revison_not_found_in_env'|trans({ 'environment' : release.environmentSource.name }) }}
    {% endif %}
{% endblock minrevid %}

{% block environmentSource %}
    {{ data.environmentSource.label }}
{% endblock environmentSource %}

{% block status %}
    {{ data.statusLabel|trans }}
{% endblock status %}

{% block environmentTarget %}
    {{ data.environmentTarget.label }}
{% endblock environmentTarget %}

{% block docs_count %}
    {{ data.revisions|length }}
{% endblock docs_count %}

{% block maxrevid %}
    {% set release = table.context %}
    {% set minrev = data.minrevid|split('/') %}
    {% set maxrev = data.maxrevid|split('/') %}
    {% if maxrev[0] == release.environmentTarget.id %}
        {{ 'message.finalized_when_user'|trans({ 'date' : maxrev[2]|date(date_time_format) ,'user' : maxrev[3] }) }}
    {% elseif minrev[0] == release.environmentTarget.id %}
        {{ 'message.finalized_when_user'|trans({ 'date' : minrev[2]|date(date_time_format) ,'user' : minrev[3] }) }}
    {% else %}
        {{ 'message.revison_not_found_in_env'|trans({ 'environment' : release.environmentTarget.name }) }}
    {% endif %}
{% endblock maxrevid %}

{% block minrevidstatus %}
    {% set release = table.context %}
    {% set minrev = data.minrevid|split('/') %}
    {% set maxrev = data.maxrevid|split('/') %}

    {% if minrev[0] == release.environmentSource.id %}
        {{ 'message.finalized_when_user'|trans({ 'date' : minrev[2]|date(date_time_format) ,'user' : minrev[3] }) }}
    {% elseif maxrev[0] == release.environmentSource.id %}
        {{ 'message.finalized_when_user'|trans({ 'date' : maxrev[2]|date(date_time_format) ,'user' : maxrev[3] }) }}
    {% else %}
        {{ 'release.unpublish_in'|trans({ 'env' : release.environmentTarget.name }) }}
    {% endif %}
{% endblock minrevidstatus %}

{% block maxrevidstatus  %}
    {% set release = table.context %}
    {% set maxrev = data.maxrevid|split('/') %}
    {% set minrev = data.minrevid|split('/') %}

    {% if maxrev[0] == release.environmentTarget.id %}
        {{ 'message.finalized_when_user'|trans({ 'date' : maxrev[2]|date(date_time_format) ,'user' : maxrev[3] }) }}
    {% elseif minrev[0] == release.environmentTarget.id %}
        {{ 'message.finalized_when_user'|trans({ 'date' : minrev[2]|date(date_time_format) ,'user' : minrev[3] }) }}
    {% else %}
         {{ 'message.revison_not_found_in_env'|trans({ 'environment' : release.environmentTarget.name }) }}
    {% endif %}
    {% if minrev[0] == release.environmentSource.id %}
        {{ 'message.revision_replace_by_date'|trans({ 'date' : minrev[2]|date(date_time_format) }) }}
    {% elseif maxrev[0] == release.environmentSource.id %}
        {{ 'message.revision_replace_by_date'|trans({ 'date' : maxrev[2]|date(date_time_format) }) }}
    {% endif %}
{% endblock maxrevidstatus  %}
