{% extends '@EMSCore/base.html.twig' %}
{% trans_default_domain 'emsco-core' %}

{% block title %}{{ 'release.index.title'|trans }}{% endblock %}
{% block pagetitle %}{{ block('title') }}{% endblock %}

{% block breadcrumb %}
	<ol class="breadcrumb">
		<li><i class="fa fa-cube}"></i> {{ 'release.menu'|trans }}</li>
   	</ol>
{% endblock %}

{% block body %}
	{%  set toolbar %}
		<a class="btn btn-primary" href="{{ path('emsco_release_add') }}" data-testid="release-button-add"><i class="fa fa-plus"></i> {{ add_label|default(form.vars.add_label)|trans }}</a>
	{%  endset %}

	{% form_theme form '@EMSCore/form/forms.html.twig' %}
	{{ form(form, {
		toolbar: toolbar,
        table_id: 'release'
	}) }}
{% endblock %}