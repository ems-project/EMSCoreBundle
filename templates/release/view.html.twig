{% extends '@EMSCore/base.html.twig' %}
{% trans_default_domain 'emsco-core' %}

{% block title %}{{ 'title.release_documents'|trans }}{% endblock %}
{% block pagetitle %}{{ block('title') }}{% endblock %}

{% block breadcrumb %}
	<ol class="breadcrumb">
		<li><a href="{{ path('emsco_release_index') }}"><i class="fa fa-cube}"></i> {{ 'key.releases'|trans }}</a></li>
		<li>{{ block('title') }}</li>
   	</ol>
{% endblock %}

{% block body %}
    {%  set toolbar %}
        {% include '@EMSCore/elements/get-button.html.twig' with {
            'url':  path('emsco_release_index'),
            'label': 'key.all_releases'|trans,
            'icon': 'cube'
        }%}
    {%  endset %}

    {% if form is not null %}
        {% form_theme form '@EMSCore/form/forms.html.twig' %}
        {{ form(form, {
            toolbar: toolbar,
            table_id: 'release-view'
        }) }}
    {% endif %}
{% endblock %}