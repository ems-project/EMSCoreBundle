{% extends '@EMSCore/base.html.twig' %}{% trans_default_domain 'emsco-core' %}
{% block title %} {{ 'key.search_options'|trans }} {%endblock %}
{% block pagetitle %} {{ 'key.search_options'|trans }} {% endblock %}

{% block breadcrumb %}
	<ol class="breadcrumb">
		<li><i class="fa fa-search"></i> {{ 'key.search_options'|trans }}</li>
   	</ol>
{% endblock %}

{% block body %}
    <div class="row">
    	<div class="col-md-6">
    		{% include '@EMSCore/entity/list-entities.html.twig' with {
    		    'entities': sortOptions,
    		    'icon': 'fa fa-sort-alpha-asc',
    		    'title': 'key.sort_options'|trans,
    		    'add_label': 'action.add_sort_option'|trans,
    		    'missing_label': 'help.add_first_sort_option'|trans,
    		    'add_route': 'ems_search_sort_option_new',
    		    'edit_route': 'ems_search_sort_option_edit',
    		    'form': sortOptionReorderForm
    		}%}
    	</div>
    	<div class="col-md-6">
    		{% include '@EMSCore/entity/list-entities.html.twig' with {
    		    'entities': aggregateOptions,
    		    'icon': 'fa fa-th',
    		    'title': 'key.aggregate_options'|trans,
    		    'add_label': 'action.add_aggregate_option'|trans,
    		    'missing_label': 'help.add_first_aggregate_option'|trans,
    		    'add_route': 'ems_search_aggregate_option_new',
    		    'edit_route': 'ems_search_aggregate_option_edit',
    		    'form': aggregateOptionReorderForm
    		}%}
    	</div>
    	<div class="col-md-6">
    		{% include '@EMSCore/entity/list-entities.html.twig' with {
    		    'entities': searchFieldOptions,
    		    'icon': 'fa fa-th',
    		    'title': 'key.search_field_options'|trans,
    		    'add_label': 'action.add_search_field_option'|trans,
    		    'missing_label': 'help.add_first_search_field_option'|trans,
    		    'add_route': 'ems_search_field_option_new',
    		    'edit_route': 'ems_search_field_option_edit',
    		    'form': searchFieldOptionReorderForm
    		}%}
    	</div>
    </div>
{% endblock %}