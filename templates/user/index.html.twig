{% extends '@EMSCore/user/user.html.twig' %}
{% trans_default_domain 'EMSCoreBundle' %}


{% block body %}
    {%  set toolbar %}
        <a class="btn btn-primary" href="{{ path('emsco_user_add') }}" data-testid="user-button-add"><i class="fa fa-plus"></i> {{ 'user.add.button'|trans }}</a>
        <a class="btn btn-default" href="{{ path('emsco_user_spreadsheet_export', {_format: 'xlsx'}) }}" data-testid="user-button-xlsx-export"><i class="fa fa-file-excel-o"></i> {{ 'user.export.excel'|trans }}</a>
        <a class="btn btn-default" href="{{ path('emsco_user_spreadsheet_export', {_format: 'csv'}) }}" data-testid="user-button-csv-export"><i class="fa fa-file-text-o"></i> {{ 'user.export.csv'|trans }}</a>
    {%  endset %}

    {% form_theme form '@EMSCore/form/forms.html.twig' %}

    {{ form(form, {
        reorder_label: 'user.index.reorder',
        toolbar: toolbar,
        table_id: 'user'
    }) }}

    {{ parent() }}
{% endblock %}