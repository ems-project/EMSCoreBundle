{% extends '@EMSCore/base.html.twig' %}{% trans_default_domain 'emsco-core' %}

{% block pagetitle %}{{ 'title.specific_permissions_for'|trans({'content_type_singular_name': contentType.name}) }}{% endblock %}

{% block breadcrumb %}
    <ol class="breadcrumb">
        <li><a href="{{ path("user.permissions") }}"><i class="fa fa-cubes"></i>{{ 'key.permission_overview_singular'|trans }}</a></li>
        <li class="active">{{ 'key.specific_roles_lowercase'|trans }}</li>
    </ol>
{% endblock %}

{% block body %}
    <div class="row">
        <div class="col-md-12">
            <div class="box ">
                <div class="box-header with-border">
                    <i class="fa fa-sitemap"></i>
                    <h3 class="box-title">{{ 'title.permissions_overview'|trans }}</h3>
                </div>
                <div class="box-body">
                    <div class="table-responsive">
                        <table class="table table-condensed table-striped">
                            <tbody>
                            <tr>
                                <th class="text-center" style="width: 10px">{{ 'field.content_type'|trans }}</th>
                                <th class="text-center" style="width: 20px">{{ 'field.icon'|trans }}</th>
                                <th>{{ 'action.view'|trans }}</th>
                                <th>{{ 'action.create'|trans }}</th>
                                <th>{{ 'action.edit'|trans }}</th>
                                <th>{{ 'action.publish'|trans }}</th>
                                <th>{{ 'action.delete'|trans }}</th>
                                <th>{{ 'field.role_trash'|trans }}</th>
                                <th>{{ 'field.role_archive'|trans }}</th>
                                <th>{{ 'field.role_show_link_create'|trans }}</th>
                                <th>{{ 'field.role_show_link_search'|trans }}</th>
                            </tr>
                                <tr class="text-{{ contentType.color }}">
                                    <td class="text-center">{{ contentType.name }}</td>
                                    <td class="text-center"><i class="{{ contentType.icon|default('fa fa-book') }}"></i></td>
                                    {% for role in [contentType.roles.view, contentType.roles.create, contentType.roles.edit, contentType.roles.publish, contentType.roles.delete, contentType.roles.trash, contentType.roles.archive, contentType.roles.show_link_create, contentType.roles.show_link_search] %}
                                    <td class="{{ html_classes({'text-muted': role == 'not-defined'}) }} ">
                                        {{ (role|replace({'ROLE_': 'ROLE.'}) ~ '.label')|lower|trans([], 'emsco-core') }}
                                    </td>
                                    {% endfor %}
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            <div class="box box-solid">
                <div class="box-header with-border">
                    <i class="fa fa-group"></i>
                    <h3 class="box-title">{{ 'key.specific_roles_of_fields'|trans }}</h3>
                </div>
                    <ol class="vertical" id="root-list" data-nested-max-level="15" data-nested-is-tree="true">
                            {% include "@EMSCore/user/permissions/specific-permissions-field.html.twig" %}
                    </ol>
            </div>
        </div>
    </div>
{% endblock %}
