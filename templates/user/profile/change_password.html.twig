{%- trans_default_domain 'emsco-core' -%}
{% extends '@EMSCore/layout.html.twig' %}

{% block title %}{{ 'title.change_your_password'|trans }}{% endblock %}
{% block pagetitle %}{{ 'title.change_your_password'|trans }}{% endblock %}
{% block subtitle %}{% endblock %}

{% block content %}
    <div class="row">
        <div class="col-md-4 col-md-offset-4">
            <div class="box box-primary">
                <div class="box-header with-border">
                    <h3 class="box-title">{{ 'title.change_your_password'|trans }}</h3>
                </div>
                {{ form_start(form, { 'action': path(routes.USER_CHANGE_PASSWORD), 'attr': { 'class': 'emsco_user_change_password' } }) }}
                    <div class="box-body">
                        {{ form_errors(form) }}
                        {{ form_row(form.current_password) }}
                        {{ form_row(form.plainPassword) }}
                    </div>
                    <div class="box-footer">
                        {{ form_row(form._token) }}
                        <input type="submit" value="{{ 'action.change_password'|trans }}" class="btn btn-primary" data-testid="change-password-submit"/>
                        <a href="{{ path(routes.USER_PROFILE) }}" class="btn pull-right btn-default" data-testid="change-password-cancel">{{ 'action.cancel'|trans }}</a>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
    {{ form_end(form) }}
{% endblock content %}