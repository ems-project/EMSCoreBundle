{%- trans_default_domain 'emsco-core' -%}
{% extends '@EMSCore/layout.html.twig' %}

{% block title %}{{ 'title.profile'|trans }}{% endblock %}
{% block pagetitle %}{{ 'title.profile'|trans }}{% endblock %}
{% block subtitle %}{% endblock %}

{% block content %}
    <div class="row">
        <div class="col-md-5 col-md-offset-4">
            <div class="box box-primary">
                <div class="box-body box-profile" data-testid="profile">
                    <a href="https://www.gravatar.com/emails" target="_blank">
                        <img class="profile-user-img img-responsive img-circle" src="https://www.gravatar.com/avatar/{{ app.user.email|lower|ems_md5 }}?d={{ "https://www.gravatar.com/avatar"|url_encode }}" alt="{{ 'key.user_profile_picture_alt'|trans }}">
                    </a>
                    <h3 class="profile-username text-center">{{ user.displayName }}</h3>
                    <p class="text-muted text-center">{{ user.username }}</p>
                    <ul class="list-group list-group-unbordered">
                        <li class="list-group-item">
                            <b>{{ 'key.login'|trans }}</b> <i class="pull-right">{{ user.username }}</i>
                        </li>
                        <li class="list-group-item">
                            <b>{{ 'field.display_name'|trans }}</b> <i class="pull-right">{{ user.displayName }}</i>
                        </li>
                        <li class="list-group-item">
                            <b>{{ 'key.email_lowercase'|trans }}</b> <i class="pull-right">{{ user.email }}</i>
                        </li>
                        <li class="list-group-item">
                            <b>{{ 'key.email_notification_lowercase'|trans }}</b> <i class="pull-right fa fa-2x fa-{% if user.emailNotification %}check-{% endif %}square-o"></i>
                        </li>
                        <li class="list-group-item">
                            <b>{{ 'key.simplified_ui'|trans({}, 'emsco-core') }}</b> <i class="pull-right fa fa-2x fa-{% if attribute(user.userOptions, 'simplified_ui') %}check-{% endif %}square-o"></i>
                        </li>
                        <li class="list-group-item">
                            <b>{{ 'key.locale_ui'|trans }}</b> <i class="pull-right">{{ user.locale|language_name  }}</i>
                        </li>
                        <li class="list-group-item" data-testid="profile-locale-preferred">
                            <b>{{ 'field.locale_preferred'|trans }}</b> <i class="pull-right">{{ user.localePreferred|locale_name }}</i>
                        </li>
                        {% if circles_object and circles_object|emsco_get_content_type %}
                            <li class="list-group-item" data-testid="profile-circles">
                                <b>{{ circles_object|emsco_get_content_type.pluralName }} : </b>
                                <i class="">
                                    {% for circle in user.circles  -%}
                                        <span class="badge text-nowrap">{{- circle|emsco_display|raw -}}</span>&nbsp;
                                    {%- endfor %}
                                </i>
                            </li>
                        {% endif %}
                        <li class="list-group-item" data-testid="profile-roles">
                            <b>Roles : </b>
                            <i class="">
                                {% for role in user.roles  -%}
                                    <span class="badge text-nowrap">{{- (role|replace({'ROLE_': 'ROLE.'}) ~ '.label')|lower|trans([], 'emsco-core') -}}</span>&nbsp;
                                {%- endfor %}
                            </i>
                        </li>
                        {%- if user.group -%}
                            <li class="list-group-item" data-testid="profile-group">
                                <b>{{ 'field.group'|trans }}</b> <i class="pull-right">{{ user.group.label }}</i>
                            </li>
                        {%- endif -%}
                        <li class="list-group-item" data-testid="profile-wysiwyg">
                            <b>{{ 'field.wysiwyg_profile'|trans }}</b> <i class="pull-right">{% if user.wysiwygProfile %}{{ user.wysiwygProfile.name }}{% endif %}</i>
                        </li>
                    </ul>
                    <div class="btn-group">
                        <a href="{{ path(routes.USER_PROFILE_EDIT) }}" class="btn btn-primary" data-testid="profile-edit"><i class="fa fa-pencil"></i> <b>{{ 'action.edit'|trans }}</b></a>
                        <a href="{{ path(routes.USER_CHANGE_PASSWORD) }}" class="btn btn-primary" data-testid="profile-change-password"><i class="fa fa-lock"></i> <b>{{ 'title.change_your_password'|trans({}, 'emsco-core') }}</b></a>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock content %}