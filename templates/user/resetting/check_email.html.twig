{%- trans_default_domain 'emsco-core' -%}
{% extends '@EMSCore/layout.html.twig' %}

{% block title %}{{ 'title.reset_password'|trans }}{% endblock %}
{% block pagetitle %}{% endblock %}
{% block subtitle %}{% endblock %}

{% block content %}
<div class="row">
    <div class="col-md-12">
        <div class="box box-info">
            <div class="box-header with-border">
                <h3 class="box-title">{{ 'title.reset_password'|trans }}</h3>
            </div>
            <div class="box-body">
                <p>{{ 'message.reset_password_check_email'|trans({'tokenLifetime': (tokenLifetime / 3600) })|nl2br }}</p>
            </div>
        </div>
    </div>
</div>
{% endblock content %}
